# Auto detect text files and perform LF normalization
* text=auto

# Force LF for shell scripts
*.sh text eol=lf
scripts/build-release text eol=lf

# Windows batch needs CRLF
*.bat text eol=crlf

# Python files
*.py text eol=lf

# Config files
*.ini text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Vendored protocol bytes are checked against SOURCES.sha256 on every platform.
protocol/v1/** text eol=lf

# Docker files
Dockerfile text eol=lf
docker-compose.yml text eol=lf
.dockerignore text eol=lf

# Git files
.gitignore text eol=lf
.gitattributes text eol=lf

# Makefile
Makefile text eol=lf
