[BOT]
; Bot interface: zh (Chinese, default) or en (English). Restart after changing.
LANGUAGE = zh
# Telegram Bot Token (从 @BotFather 获取)
TOKEN = your_bot_token_here

# 频道 ID (格式: @channel_username 或 -100xxxxxxxxxx)
CHANNEL_ID = @your_channel

# 数据库文件路径
DB_PATH = data/submissions.db

# 会话超时时间（秒）
TIMEOUT = 300

# 允许的最大标签数量
ALLOWED_TAGS = 30

# 机器人所有者的 Telegram User ID
OWNER_ID = your_user_id

# 管理员 User ID 列表（逗号分隔，可选）
# 注意：OWNER_ID 会自动添加到管理员列表
# ADMIN_IDS = 123456789,987654321

# 是否在投稿中显示投稿人信息 (true/false)
SHOW_SUBMITTER = true

# 是否向所有者发送新投稿通知 (true/false)
NOTIFY_OWNER = true

# 机器人模式: MEDIA (仅媒体), DOCUMENT (仅文档), MIXED (混合模式)
BOT_MODE = MIXED

# 允许的文档类型（扩展名或MIME，逗号分隔），留空或 * 表示允许所有
ALLOWED_FILE_TYPES = *

# 投稿默认拦截的危险文件类型（黑名单，默认开启）：可执行软件、脚本与压缩包。
# 媒体类（图片/视频/GIF/音频）不受限制；文本文档如 TXT、PDF、MD 可正常投稿。
# 自定义：BLOCKED_FILE_TYPES = .exe,.zip（整体覆盖内置列表）；关闭：BLOCKED_FILE_TYPES = none
# BLOCKED_FILE_TYPES =

# 投稿频率限制：每用户每小时最多发起投稿次数（0 为关闭），默认 10
SUBMIT_LIMIT_PER_HOUR = 10

# 是否将 HTTP API 投稿先发送到私有审核群
# 兼容保留：API 投稿（含 PixivFlow 自动稿）固定进入审核，此开关无法让 API 绕过审核
API_REVIEW_REQUIRED = true

# 是否将 Telegram 聊天 /submit 投稿先发送到私有审核群（默认 false = 直接发布）
CHAT_REVIEW_REQUIRED = false

# 是否将 Mini App 投稿先发送到私有审核群（独立开关，默认 true）
MINIAPP_REVIEW_REQUIRED = true

# 私有审核群 ID，任一审核开关为 true 时必填（且不能与发布频道相同）
# REVIEW_CHAT_ID = -1001234567890

# ---------- Mini App（可选）----------
# 是否启用 Mini App 界面。默认 true；只有显式写 false/0/no/off 才关闭。
MINIAPP_ENABLED = true

# Mini App 的「热门 / 文章详情 / 文章媒体」浏览页（默认 true，独立于投稿流程）
MINIAPP_CONTENT_ENABLED = true

# 频道帖子 footer 是否追加 📱 Mini App 投稿入口（默认 false）
# MINIAPP_SUBMIT_CTA = false

# 公网 HTTPS 的 Mini App 地址。留空时取 WEBHOOK_URL + /app/；
# 两者都没有时聊天菜单按钮不会出现（Mini App 需要 HTTPS，普通 Polling Bot 不需要）。
# MINIAPP_PUBLIC_URL = https://your-domain.com/app/

# BotFather 里绑定的 Direct Mini App short name（可选）
# MINIAPP_SHORT_NAME =

# 注意：MINIAPP_SESSION_SECRET（≥32 字符随机串）与 MINIAPP_SESSION_TTL（秒，默认 1800）
# 只从环境变量读取，写在本文件里不生效，必须用环境变量 / .env 注入。
# 缺失或不足 32 字符时 Mini App 会话签发直接失败（不会降级放行）。

# 运行模式: AUTO (自动) | POLLING (轮询) | WEBHOOK (Webhook)
# - AUTO: 默认；存在有效公网 HTTPS WEBHOOK_URL 时使用 Webhook，否则 Polling
# - POLLING: 机器人主动拉取消息，适合无公网地址的机器
# - WEBHOOK: Telegram 推送消息到服务器，适合生产环境，更高效
RUN_MODE = AUTO

[WEBHOOK]
# Webhook 配置（RUN_MODE=AUTO/WEBHOOK 时使用）

# 外部访问地址（必填，例如: https://your-app.fly.dev）
# 注意：必须是 HTTPS 且有效的域名
URL = 

# Webhook 监听端口（默认 8080）
PORT = 8080

# Webhook 路径（默认 /webhook）
PATH = /webhook

# Webhook Secret Token（可选，用于验证请求来源）
# 留空则自动生成随机 token
SECRET_TOKEN = 

[SEARCH]
# 搜索索引目录
INDEX_DIR = data/search_index

# 是否启用搜索
ENABLED = true

# 分词器：jieba | simple
# - jieba: 中文分词效果更好，但占用 ~20MB 词典内存
# - simple: 内存占用更低（推荐内存受限环境）
ANALYZER = jieba

# 搜索结果高亮：true|false（关闭可进一步减少开销）
HIGHLIGHT = false

[DB]
# SQLite page cache 大小（KB），影响内存占用
# 内存受限可设 1024（1MB），通常 1024~4096 即可
CACHE_SIZE_KB = 1024

[NOVEL_PREVIEW]
# 可选发布增强：TXT 小说通过 TelePress 发布到 Telegraph 提供「在线阅读」。
# 默认关闭；开启后仅增加在线预览链接，TXT document 仍正常发送到频道，
# Telegraph 失败/超时绝不导致投稿失败（§telepress-preview）。
ENABLED = false

# Telegraph 账户 access token（Secret，不写日志；留空 = 预览关闭）
# TELEGRAPH_ACCESS_TOKEN =

# 单次预览尝试的严格超时（秒）——Telegraph 不能无限拖住发布
TIMEOUT_SECONDS = 15

# 读取 TXT 正文的大小上限（字节），防止超大文件占用发布路径内存
MAX_BYTES = 4194304
