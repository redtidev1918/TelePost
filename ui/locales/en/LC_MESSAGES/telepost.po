msgstr ""
"\n"
"👑 <b>Admin</b>\n"
"/schedule Scheduled tasks (send /schedule for instructions)\n"
"/stats Global stats\n"
"/searchuser &lt;ID&gt; Find a user’s posts\n"
"/ban_user &lt;ID&gt; Block user\n"
"/ban_api &lt;ID&gt; Disable API access\n"
"/blacklist Manage blocklist\n"
"/tokens List API tokens\n"
"/gen_token Generate API token\n"
"/revoke_token Revoke API token\n"
"/delete_posts Delete posts in bulk\n"
"/pin_status Pinned status\n"
"/rebuild_index Rebuild index\n"
"/sync_index Sync index\n"
"/index_stats Index stats\n"
"/optimize_index Optimize index\n"
"/botconfig Bot configuration\n"
"/debug Debug\n"

